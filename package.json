{
  "name": "project-vayu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "deploy": "pnpm --filter web build && pnpm --filter server run deploy",
    "check-types": "pnpm -r check-types && tsc --noEmit -p e2e",
    "test": "pnpm --filter server test",
    "test:e2e": "pnpm --filter web build && playwright test",
    "check": "oxlint && oxfmt --write"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@project-vayu/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
