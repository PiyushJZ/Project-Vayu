{
  "name": "project-vayu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r --if-present build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @project-vayu/db db:push",
    "db:studio": "pnpm --filter @project-vayu/db db:studio",
    "db:generate": "pnpm --filter @project-vayu/db db:generate",
    "db:migrate": "pnpm --filter @project-vayu/db db:migrate",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@project-vayu/config": "workspace:*",
    "@types/node": "^26.4.1",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
