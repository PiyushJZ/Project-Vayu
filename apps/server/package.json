{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node -e \"import('node:fs').then((fs) => fs.mkdirSync('../web/dist', { recursive: true }))\" && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "evlog": "^2.33.1",
    "hono": "^4.13.18",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@project-vayu/config": "workspace:*",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "wrangler": "^4.161.0"
  }
}
